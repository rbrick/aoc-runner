module Main (main) where

import qualified Control.Exception as RunnerException
import qualified System.IO as RunnerIO

{{ .Solution }}

main :: IO ()
main = do
  stdIn <- RunnerIO.getContents

  -- answers are lazy, force them before printing so a crash never leaves half an answer behind
  answerOne <- RunnerException.evaluate (partOne stdIn)
  _ <- RunnerException.evaluate (length answerOne)

  answerTwo <- RunnerException.evaluate (partTwo stdIn)
  _ <- RunnerException.evaluate (length answerTwo)

  -- answers are separated by a NUL byte so either can span multiple lines
  RunnerIO.putStr (answerOne ++ "\0" ++ answerTwo)
